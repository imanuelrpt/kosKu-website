#--------------------------------------------------------------------
# KosKu - Sistem Manajemen Kos-kosan
# Contoh konfigurasi environment
#
# Cara pakai:
#   1. Copy file ini menjadi `.env`
#      Windows (PowerShell):  Copy-Item .env.example .env
#   2. Sesuaikan nilai di bawah dengan environment Anda.
#
# Catatan: file `.env` TIDAK boleh di-commit ke git.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
# Gunakan `production` saat deploy ke hosting/VPS.
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# baseURL HARUS diakhiri garis miring (/)
# Contoh produksi:  app.baseURL = 'https://kosku.example.com/'
app.baseURL = 'http://localhost/manajemen-kost/public/'
# Kosongkan agar URL bersih tanpa index.php (butuh mod_rewrite)
app.indexPage = ''
app.forceGlobalSecureRequests = false
app.CSPEnabled = false
app.defaultLocale = 'id'
app.appTimezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = db_kost
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION
# WAJIB diganti untuk production:
#   php spark key:generate
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# JANGAN mengisi "null": nilainya dibaca sebagai teks sehingga menjadi path
# relatif (folder bernama "null") dan memicu error saat session ditulis.
# Biarkan dikomentari agar CI4 memakai default: writable/session.
# Butuh lokasi lain? Isi path ABSOLUT dengan tanda kutip, contoh:
# session.savePath = 'C:/laragon/www/manajemen-kost/writable/session'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4
